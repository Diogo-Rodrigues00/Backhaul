{
  "name": "backhaul-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:ci": "expo export -p web",
    "orcamento": "node scripts/orcamento-bundle.mjs",
    "e2e": "playwright test",
    "lhci:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
    "lhci:desktop": "lhci autorun --config=./lighthouserc.desktop.cjs",
    "verificar:proibidos": "node scripts/verificar-proibidos.mjs",
    "verificar": "node scripts/verificar.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"mocks/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{mjs,cjs}\" playwright.config.ts lighthouserc.*.cjs",
    "build:vercel": "expo export -p web && node scripts/pos-build-web.mjs",
    "gerar:icones": "node scripts/gerar-icones.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "0.15.1",
    "@mswjs/http-middleware": "^0.10.3",
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.15.0",
    "serve": "^14.2.6",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
