# Copie este arquivo para .env e coloque a sua senha real.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://postgres:SUA_SENHA_AQUI@localhost:5432/backhaul

# Porta em que a API vai escutar
PORT=3000

# Segredo usado para assinar os tokens JWT do login. Use um texto longo e aleatório.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
