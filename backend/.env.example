# Copie este arquivo para .env e coloque a sua senha real.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://postgres:SUA_SENHA_AQUI@localhost:5432/backhaul

# Porta em que a API vai escutar
PORT=3000

# Segredo usado para assinar os tokens JWT do login. Use um texto longo e aleatório.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Sites (origens) que podem chamar a API pelo navegador, separados por vírgula.
# Origem = protocolo + domínio + porta, sem barra no final. Ex.:
# CORS_ORIGIN=http://localhost:8081,https://backhaul.exemplo.com
CORS_ORIGIN=http://localhost:8081

# Pagamentos. O padrão é "simulado": não fala com nenhum gateway.
# "sandbox" usa o ambiente de TESTE do Asaas (dinheiro de mentira) e exige as duas variáveis abaixo.
# NUNCA coloque chaves reais aqui nem no GitHub: elas ficam só nas variáveis de ambiente do Render.
PAGAMENTOS_MODO=simulado
# ASAAS_API_KEY=
# Token que o Asaas envia no header asaas-access-token dos webhooks (você escolhe; texto longo e aleatório).
# ASAAS_WEBHOOK_TOKEN=
